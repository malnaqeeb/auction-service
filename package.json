{
  "name": "api-gateway-audit-tool",
  "version": "1.0.0",
  "description": "Tool to audit API Gateway endpoints and their associated custom authorizers",
  "main": "api-gateway-audit.ts",
  "scripts": {
    "build": "tsc api-gateway-audit.ts",
    "start": "node api-gateway-audit.js",
    "dev": "ts-node api-gateway-audit.ts",
    "audit": "npm run dev"
  },
  "dependencies": {
    "@aws-sdk/client-api-gateway": "^3.470.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0",
    "ts-node": "^10.9.0"
  },
  "keywords": [
    "aws",
    "api-gateway",
    "security",
    "audit",
    "authorization",
    "typescript"
  ],
  "author": "API Security Team",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  }
}
